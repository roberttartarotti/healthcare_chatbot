# =============================================================================
# Healthcare Chatbot System - Environment Variables
# =============================================================================
# Copy this file to .env and update the values as needed
# cp .env.example .env

# =============================================================================
# Docker Compose Project Name
# =============================================================================
COMPOSE_PROJECT_NAME=healthcare_chatbot

# =============================================================================
# RabbitMQ Configuration
# =============================================================================
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=password
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_VHOST=/

# =============================================================================
# MongoDB Configuration
# =============================================================================
MONGODB_USER=admin
MONGODB_PASSWORD=DPHfeJbUPEdtRIqvVaiH2ULw9dk9RaQ0ce7ietEFjHkTvyLBcA
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=healthcare_db

# MongoDB Connection Options
MONGODB_CONNECTION_TIMEOUT=5000
MONGODB_SOCKET_TIMEOUT=5000
MONGODB_MAX_POOL_SIZE=10

# MongoDB Logging
MONGODB_LOG_LEVEL=INFO
MONGODB_LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dvQQdC2qPMznGUIticV077OSnJzrX4Vgs9lYLdAvfUIJHpjSE6


# =============================================================================
# MCP Server Configuration
# =============================================================================
MCP_HOST=localhost
MCP_PORT=8001
MCP_PROTOCOL=stdio

# MCP Logging
MCP_LOG_LEVEL=INFO
MCP_LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# =============================================================================
# Celery Configuration
# =============================================================================
# Celery Configuration
# =============================================================================
CELERY_BROKER_URL=amqp://admin:password@localhost:5672/
CELERY_RESULT_BACKEND=rpc://
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_LOG_LEVEL=INFO
CELERY_TASK_SERIALIZER=json
CELERY_TIMEZONE=America/Sao_Paulo
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000
CELERY_TASK_DEFAULT_QUEUE=default
CELERY_TASK_DEFAULT_EXCHANGE=default
CELERY_TASK_DEFAULT_ROUTING_KEY=default
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=true
CELERY_TASK_IGNORE_RESULT=false
CELERY_TASK_STORE_EAGER_RESULT=true
CELERY_SECURITY_KEY=
CELERY_SECURITY_CERTIFICATE=
CELERY_SECURITY_CERT_STORE=
# =============================================================================
CELERY_BROKER_URL=amqp://admin:password@localhost:5672/
CELERY_RESULT_BACKEND=rpc://

# =============================================================================
# Development Settings
# =============================================================================
# Set to true for development, false for production
DEBUG=false

# =============================================================================
# Security Settings
# =============================================================================
# Generate a secure secret key for your application
SECRET_KEY=bPspqKxhkMvZFUgZ7f4dlhUeEnU8h9Y6SFcozRhePKNcot5Ira

# =============================================================================
# External Services (Future Use)
# =============================================================================
# REST API Configuration (when created later)
REST_HOST=localhost
REST_PORT=8000
REST_DEBUG=false

# =============================================================================
# Database Initialization
# =============================================================================
# Set to true to initialize database with sample data
INIT_DATABASE=false

# =============================================================================
# Logging Configuration
# =============================================================================
# Global logging level
LOG_LEVEL=INFO

# =============================================================================
# Health Check Settings
# =============================================================================
# Health check intervals (in seconds)
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=40
